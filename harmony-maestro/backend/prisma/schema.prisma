generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String
  role            String           @default("admin") // "admin" | "user"
  sexo            String?          // "M" ou "F"
  experiencia     Int?             // Experiência em anos
  instrumento     String?          // Instrumento principal
  instrumentosQtd Int?             // Quantos instrumentos toca
  idade           DateTime?        // Data de nascimento
  disponibilidade String?          // Disponibilidade
  celular         String?          // Número de celular
  
  invites         Invite[]         @relation("UserInvites")
  receivedInvites Invite[]         @relation("UserReceivedInvites")
  activityLogs    ActivityLog[]
  notifications   Notification[]   @relation("UserNotifications")
  events          Event[]
  songs           Song[]
  series          Series[]
  notifEmail      Boolean          @default(false)
  statusAcount    String           @default("active")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  presenca        Presenca[]
  partitura       Partitura[]
}

model Invite {
  id           Int       @id @default(autoincrement())
  inviterId    Int
  inviteeId    Int?
  inviteeEmail String
  status       String    @default("pending") // "pending" | "accepted" | "rejected"
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  inviter User  @relation("UserInvites", fields: [inviterId], references: [id])
  invitee User? @relation("UserReceivedInvites", fields: [inviteeId], references: [id])
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  date        DateTime
  location    String?
  description String?
  color       String?   @default("#3b82f6")
  status      String    @default("pendente") // escalado, pendente, cancelado
  seriesId    Int?
  series      Series?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Song {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String?
  fileUrl   String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Partitura {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  arquivoUrl  String
  criadoEm    DateTime @default(now())
  usuario     User     @relation(fields: [usuarioId], references: [id])
  usuarioId   Int
}

model Series {
  id        Int       @id @default(autoincrement())
  title     String?
  startDate DateTime
  hour      String?
  events    Event[]
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  status_presenca String    @default("Aguardando Resposta") // "Confirmou presença", "Não Disponível", "Aguardando Resposta"
  presenca Presenca[]
}

model Presenca {
  id        Int      @id @default(autoincrement())
  userId    Int
  serieId   Int
  status    String   @default("Aguardando Resposta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  serie Series @relation(fields: [serieId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  date      DateTime @default(now())
  userId    Int
  user      User     @relation("UserNotifications", fields: [userId], references: [id])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  type      String   // "song_added", "member_joined", "event_created", etc
  message   String
  createdAt DateTime @default(now())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
}

